[
  { "id": "alpha-tab", "type": "tab", "label": "Alpha SCADA", "disabled": false, "info": "Alpha (plaintext baseline) HMI — no crypto" },

  { "id": "alpha-broker", "type": "mqtt-broker", "name": "EMQX Alpha", "broker": "192.168.100.100", "port": "1883", "clientid": "nodered-scada-a", "autoConnect": true, "keepalive": "60", "cleansession": true },

  { "id": "alpha-ui-base", "type": "ui_base", "theme": { "name": "theme-dark", "lightTheme": { "default": true, "enabled": false }, "darkTheme": { "default": true, "enabled": true } }, "site": { "name": "ViPeR Alpha SCADA", "hideToolbar": "false", "allowSwipe": "false", "dateFormat": "DD/MM/YYYY", "sizes": { "sx": 48, "sy": 48, "gx": 6, "gy": 6, "cx": 6, "cy": 6, "px": 0, "py": 0 } } },
  { "id": "alpha-ui-tab", "type": "ui_tab", "name": "Alpha", "icon": "dashboard", "order": 1, "disabled": false, "hidden": false },
  { "id": "alpha-grp-telem", "type": "ui_group", "name": "Telemetria (plaintext)", "tab": "alpha-ui-tab", "order": 1, "disp": true, "width": 6, "collapse": false },
  { "id": "alpha-grp-ctrl", "type": "ui_group", "name": "Estado & Controlo", "tab": "alpha-ui-tab", "order": 2, "disp": true, "width": 6, "collapse": false },

  { "id": "alpha-mqtt-telem", "type": "mqtt in", "name": "ALPHA/+/telemetria", "topic": "ALPHA/+/telemetria", "qos": "0", "datatype": "json", "broker": "alpha-broker", "x": 150, "y": 80, "wires": [ ["alpha-fn-temp", "alpha-fn-hum", "alpha-fn-node"] ] },
  { "id": "alpha-fn-temp", "type": "function", "name": "temp", "func": "return { payload: msg.payload.temp };", "outputs": 1, "x": 420, "y": 60, "wires": [ ["alpha-gauge-temp"] ] },
  { "id": "alpha-fn-hum", "type": "function", "name": "hum", "func": "return { payload: msg.payload.hum };", "outputs": 1, "x": 420, "y": 100, "wires": [ ["alpha-gauge-hum"] ] },
  { "id": "alpha-fn-node", "type": "function", "name": "node", "func": "return { payload: msg.payload.node };", "outputs": 1, "x": 420, "y": 140, "wires": [ ["alpha-text-node"] ] },

  { "id": "alpha-gauge-temp", "type": "ui_gauge", "name": "", "group": "alpha-grp-telem", "order": 1, "width": 3, "height": 3, "gtype": "gage", "title": "Temperatura", "label": "°C", "format": "{{value}}", "min": 0, "max": 50, "colors": ["#00b3fd", "#5fd35f", "#ff4d4d"], "seg1": "20", "seg2": "35", "x": 680, "y": 60, "wires": [] },
  { "id": "alpha-gauge-hum", "type": "ui_gauge", "name": "", "group": "alpha-grp-telem", "order": 2, "width": 3, "height": 3, "gtype": "gage", "title": "Humidade", "label": "%", "format": "{{value}}", "min": 0, "max": 100, "colors": ["#ffd166", "#5fd35f", "#00b3fd"], "seg1": "40", "seg2": "70", "x": 680, "y": 100, "wires": [] },
  { "id": "alpha-text-node", "type": "ui_text", "name": "", "group": "alpha-grp-telem", "order": 3, "width": 6, "height": 1, "label": "Nó", "format": "{{msg.payload}}", "layout": "row-spread", "x": 680, "y": 140, "wires": [] },

  { "id": "alpha-mqtt-estado", "type": "mqtt in", "name": "ALPHA/+/estado", "topic": "ALPHA/+/estado", "qos": "0", "datatype": "json", "broker": "alpha-broker", "x": 150, "y": 220, "wires": [ ["alpha-fn-estado"] ] },
  { "id": "alpha-fn-estado", "type": "function", "name": "estado", "func": "return { payload: msg.payload.status || msg.payload.relay };", "outputs": 1, "x": 420, "y": 220, "wires": [ ["alpha-text-estado"] ] },
  { "id": "alpha-text-estado", "type": "ui_text", "name": "", "group": "alpha-grp-ctrl", "order": 1, "width": 6, "height": 1, "label": "Estado do Relé", "format": "{{msg.payload}}", "layout": "row-spread", "x": 680, "y": 220, "wires": [] },

  { "id": "alpha-btn-on", "type": "ui_button", "name": "LIGAR", "group": "alpha-grp-ctrl", "order": 2, "width": 3, "height": 1, "label": "LIGAR", "color": "#0d0e12", "bgcolor": "#4ade80", "payload": "{\"command\":\"relay_on\"}", "payloadType": "json", "topic": "ALPHA/CC8DA20C7AF8/comando", "topicType": "str", "x": 150, "y": 320, "wires": [ ["alpha-mqtt-out"] ] },
  { "id": "alpha-btn-off", "type": "ui_button", "name": "DESLIGAR", "group": "alpha-grp-ctrl", "order": 3, "width": 3, "height": 1, "label": "DESLIGAR", "color": "#0d0e12", "bgcolor": "#f87171", "payload": "{\"command\":\"relay_off\"}", "payloadType": "json", "topic": "ALPHA/CC8DA20C7AF8/comando", "topicType": "str", "x": 150, "y": 360, "wires": [ ["alpha-mqtt-out"] ] },
  { "id": "alpha-mqtt-out", "type": "mqtt out", "name": "comando", "topic": "", "qos": "0", "retain": "", "broker": "alpha-broker", "x": 420, "y": 340, "wires": [] }
]
